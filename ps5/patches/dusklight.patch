 void open_iso_picker() noexcept {
     ensure_initialized();
+#ifdef __PROSPERO__
+    // SDL has no PS5 file-dialog backend. All entry points use this controller UI.
+    Modal::Props props{.title = "Select Disc Image"};
+    try {
+        if (const char* error = std::getenv("DUSK_PS5_STORAGE_ERROR"))
+            throw std::runtime_error(error);
+        const char* folder = std::getenv("DUSK_PS5_IMAGES");
+        if (!folder) throw std::runtime_error("Protected disc folder is unavailable");
+        auto available = ps5_storage::discs(folder);
+        for (const char* usb : {"/mnt/usb0", "/mnt/usb1"}) {
+            auto found = ps5_storage::discs(usb);
+            available.insert(available.end(), found.begin(), found.end());
+        }
+        props.bodyText = available.empty() ?
+            std::string("Close Dusklight and copy your GameCube ISO/GCM or CISO to ") +
+                folder + ". Then reopen Dusklight and select it here. USA, PAL and Japan revision 0 are supported. Wii discs and other compressed formats are not supported." :
+            "Choose a GameCube disc image. A changed disc takes effect after restarting Dusklight.";
+        for (const auto& disc : available) {
+            props.actions.push_back(ModalAction{
+                .label = disc.path.filename().string() + " (" + disc.region + ")",
+                .onPressed = [path = disc.path.string()](Modal& modal) {
+                    modal.pop();
+                    begin_disc_verification(path);
+                },
+            });
+        }
+    } catch (const std::exception& error) {
+        props.bodyText = error.what();
+        props.icon = "warning";
+    }
+    props.actions.push_back(ModalAction{
+        .label = "Cancel", .onPressed = [](Modal& modal) { modal.pop(); },
+    });
+    props.isVertical = true;
+    if (auto* host = top_document()) host->push(std::make_unique<Modal>(std::move(props)));
+#else
     borealis::file_select::open_file(
         {
             .parentWindow = aurora::window::get_sdl_window(),
             .filters = kDiscFileFilters,
         },
         &file_dialog_callback);
+#endif
 }
 
